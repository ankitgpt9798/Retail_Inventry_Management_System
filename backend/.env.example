PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/retail_inventory
CLIENT_URL=http://localhost:5173
# Separate database for automated tests (it gets wiped on every test run)
MONGO_URI_TEST=mongodb://127.0.0.1:27017/retail_inventory_test

# Long random string used to sign login tokens. Generate your own with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN_DAYS=1

# Time zone used by reports for "which day / which month" (India = +05:30)
REPORT_UTC_OFFSET=+05:30

# First admin account, created by: npm run seed:admin
ADMIN_NAME=System Admin
ADMIN_EMAIL=admin@retail.local
ADMIN_PASSWORD=change-this-password
