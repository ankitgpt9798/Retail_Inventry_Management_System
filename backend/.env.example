PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/retail_inventory
CLIENT_URL=http://localhost:5173
# Separate database for automated tests (it gets wiped on every test run)
MONGO_URI_TEST=mongodb://127.0.0.1:27017/retail_inventory_test

# Long random string used to sign login tokens. Generate your own with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN_DAYS=1

# Time zone used by reports for "which day / which month" (India = +05:30)
REPORT_UTC_OFFSET=+05:30

# First admin account, created by: npm run seed:admin
ADMIN_NAME=System Admin
ADMIN_EMAIL=admin@retail.local
ADMIN_PASSWORD=change-this-password

# Login protection against password guessing (all optional; these are the defaults)
# Wrong passwords on ONE account before it is locked, and for how long
# LOGIN_MAX_FAILED_ATTEMPTS=5
# LOGIN_LOCK_MINUTES=15
# Wrong passwords from ONE network address before it is locked, and for how long
# LOGIN_IP_MAX_FAILURES=20
# LOGIN_IP_WINDOW_MINUTES=15

# Behind a reverse proxy (nginx, a load balancer, a hosting platform)? Set this to the number of proxies
# in front of the API (usually 1); otherwise every user looks like the same address and shares one login limit.
# TRUST_PROXY=1
